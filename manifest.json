{
  "manifest_version": 3,
  "name": "Copy Task for Azure DevOps",
  "version": "1.0.0",
  "description": "Formata e copia work items do Azure DevOps como mensagens de commit.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.azure.com/*",
        "https://*.visualstudio.com/*"
      ],
      "js": [
        "CopyTask.js",
        "PR_WorkItem_CopyTask.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
